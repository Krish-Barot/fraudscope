# apps/api/Dockerfile.worker
# Same image as API but starts the worker process instead

FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
COPY apps/api/package*.json ./apps/api/

RUN npm install

ENV PATH="/app/node_modules/.bin:$PATH"

COPY apps/api/ ./apps/api/

CMD ["npm", "run", "worker", "--workspace=apps/api"]